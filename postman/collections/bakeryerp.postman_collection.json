              "id": "e918c616-9843-401f-bd75-b10197318a68",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"product\": \"{{sausage_roll_id}}\",\r\n  \"revision\": 1,\r\n  \"batch_size\": 1000,\r\n  \"yield_percentage\": 98,\r\n  \"status\": \"draft\",\r\n  \"lines\": [\r\n    {\r\n      \"sequence\": 1,\r\n      \"line_type\": \"PROCESS\",\r\n      \"text\": \"Meat Preparation\"\r\n    },\r\n    {\r\n      \"sequence\": 2,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{pork_loin_id}}\",\r\n      \"quantity\": 200\r\n    },\r\n    {\r\n      \"sequence\": 3,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{pork_shoulder_id}}\",\r\n      \"quantity\": 300\r\n    },\r\n    {\r\n      \"sequence\": 4,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{pork_fat_id}}\",\r\n      \"quantity\": 100\r\n    },\r\n    {\r\n      \"sequence\": 5,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{salt_id}}\",\r\n      \"quantity\": 10\r\n    },\r\n    {\r\n      \"sequence\": 6,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{spices_id}}\",\r\n      \"quantity\": 5\r\n    },\r\n    {\r\n      \"sequence\": 7,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{rusk_id}}\",\r\n      \"quantity\": 50\r\n    },\r\n    {\r\n      \"sequence\": 8,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{ice_id}}\",\r\n      \"quantity\": 30\r\n    },\r\n    {\r\n      \"sequence\": 9,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Mince meat and mix with all ingredients until consistent paste is achieved\"\r\n    },\r\n\r\n    {\r\n      \"sequence\": 10,\r\n      \"line_type\": \"PROCESS\",\r\n      \"text\": \"Pastry Preparation\"\r\n    },\r\n    {\r\n      \"sequence\": 11,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{flour_id}}\",\r\n      \"quantity\": 400\r\n    },\r\n    {\r\n      \"sequence\": 12,\r\n      \"line_type\": \"MATERIAL\",\r\n      \"product\": \"{{margarine_id}}\",\r\n      \"quantity\": 200\r\n    },\r\n    {\r\n      \"sequence\": 13,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Fold and laminate dough to create layered puff pastry\"\r\n    },\r\n\r\n    {\r\n      \"sequence\": 14,\r\n      \"line_type\": \"PROCESS\",\r\n      \"text\": \"Assembly Line\"\r\n    },\r\n    {\r\n      \"sequence\": 15,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Roll pastry sheets onto conveyor\"\r\n    },\r\n    {\r\n      \"sequence\": 16,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Extrude sausage meat evenly along pastry\"\r\n    },\r\n    {\r\n      \"sequence\": 17,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Wrap pastry around filling and seal using egg wash\"\r\n    },\r\n    {\r\n      \"sequence\": 18,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Cut into uniform sausage roll portions\"\r\n    },\r\n\r\n    {\r\n      \"sequence\": 19,\r\n      \"line_type\": \"PROCESS\",\r\n      \"text\": \"Baking\"\r\n    },\r\n    {\r\n      \"sequence\": 20,\r\n      \"line_type\": \"INSTRUCTION\",\r\n      \"text\": \"Bake in oven at 180°C until golden brown\"\r\n    },\r\n\r\n    {\r\n      \"sequence\": 21,\r\n      \"line_type\": \"BYPRODUCT\",\r\n      \"product\": \"{{waste_trimmings}}\",\r\n      \"quantity\": 20\r\n    },\r\n\r\n    {\r\n      \"sequence\": 22,\r\n      \"line_type\": \"TEXT\",\r\n      \"text\": \"Cool and package finished sausage rolls for distribution\"\r\n    }\r\n  ]\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
